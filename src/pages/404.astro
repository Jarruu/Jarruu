---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<Layout lang={lang} title="404 Not Found">
	<section class="not-found container">
		<p class="mono-meta">ERR 404 // ROUTE NOT FOUND</p>
		<h1>Requested page or schematic does not exist.</h1>
		<p class="not-found-sub">
			Return to the main datasheet overview or open the works archive.
		</p>
		<div class="not-found-actions">
			<a href="/" class="btn-primary">Return to Overview (EN)</a>
			<a href="/id/" class="btn-secondary">Kembali ke Beranda (ID)</a>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		padding-block: clamp(4rem, 12vw, 8rem);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.not-found h1 {
		font-size: clamp(2rem, 4vw, 3.25rem);
	}

	.not-found-sub {
		color: var(--muted);
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding-top: 0.5rem;
	}
</style>
