---
import { experiences, profile } from '../../data/profile';
import { type Lang, useTranslations } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="exp-section">
	<div class="container">
		<div class="section-header">
			<span class="section-index">{t('exp.index')}</span>
			<span class="mono-meta">FIELD &amp; LABORATORY LOG</span>
		</div>

		<h2 class="exp-heading" data-reveal>{t('exp.heading')}</h2>

		<div class="timeline-wrap" data-timeline-wrap>
			<div class="timeline-rail" aria-hidden="true">
				<div class="timeline-fill" data-timeline-progress></div>
			</div>

			<div class="timeline-list">
				{
					experiences.map((item) => (
						<article class="timeline-item" data-reveal>
							<div class="timeline-meta">
								<span class="mono-meta item-code">{item.id}</span>
								<span class:list={['mono-meta', { 'placeholder-tag': item.todoPeriod }]}>
									{item.period[lang]}
								</span>
							</div>

							<div class="timeline-content">
								<h3 class="item-role">{item.role[lang]}</h3>
								<p class="item-org mono-meta">
									{item.org} · {item.location}
								</p>
								<p class="item-summary">{item.summary[lang]}</p>
								<ul class="item-highlights">
									{item.highlights[lang].map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>
		</div>

		<div class="edu-block" data-reveal>
			<div class="edu-label mono-meta">{t('exp.edu.label')}</div>
			<div class="edu-body">
				<h3 class="edu-degree">{profile.education.degree[lang]}</h3>
				<p class="edu-inst">{profile.education.institution}</p>
				<p class="mono-meta">{profile.education.lab}</p>
			</div>
			<div class="edu-period">
				<span class="placeholder-tag">{profile.education.period[lang]}</span>
			</div>
		</div>
	</div>
</section>

<style>
	.exp-section {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
		border-bottom: 1px solid var(--line);
	}

	.exp-heading {
		font-size: clamp(1.85rem, 3.4vw, 2.85rem);
		margin-bottom: clamp(2rem, 4vw, 3.5rem);
	}

	.timeline-wrap {
		position: relative;
		padding-left: clamp(1.5rem, 3vw, 2.75rem);
	}

	.timeline-rail {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background-color: var(--line);
	}

	.timeline-fill {
		width: 100%;
		height: 100%;
		background-color: var(--fg);
		transform-origin: top center;
	}

	.timeline-list {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: 1.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--line);
		align-items: start;
	}

	.timeline-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.item-role {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		margin-bottom: 0.25rem;
	}

	.item-org {
		margin-bottom: 0.75rem;
	}

	.item-summary {
		margin-bottom: 0.75rem;
	}

	.item-highlights {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--muted);
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.edu-block {
		margin-top: 2.5rem;
		padding: 1.5rem;
		border: 1.5px solid var(--border-strong);
		background-color: var(--surface);
		display: grid;
		grid-template-columns: 220px 1fr auto;
		gap: 1.5rem;
		align-items: center;
	}

	.edu-degree {
		font-size: 1.25rem;
	}

	.edu-inst {
		font-weight: 500;
	}

	@media (max-width: 860px) {
		.timeline-item {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.edu-block {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
