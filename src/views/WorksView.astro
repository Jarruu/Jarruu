---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { type Lang, useTranslations, localePath } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = localePath(lang, '');
const works = (await getCollection('works', (entry) => entry.data.lang === lang)).sort(
	(a, b) => a.data.order - b.data.order,
);
const worksWithPreview = await Promise.all(
	works.map(async (entry) => ({
		entry,
		previewSrc: (await getImage({ src: entry.data.cover, width: 680, format: 'webp' })).src,
	})),
);
const categories: Record<string, string> = {
	iot: t('works.filter.iot'),
	ai: t('works.filter.ai'),
	software: t('works.filter.software'),
};
const countLabel = String(works.length).padStart(2, '0');
---

<Layout lang={lang} title={t('works.heading')}>
	<section class="works-page" data-works-archive>
		<div class="container">
			<div class="page-topbar">
				<nav class="breadcrumb-nav" aria-label="Breadcrumb">
					<ol class="breadcrumb-list">
						<li>
							<a href={homeUrl} class="breadcrumb-link">{t('detail.breadcrumb.home')}</a>
						</li>
						<li class="breadcrumb-sep" aria-hidden="true">›</li>
						<li class="breadcrumb-current" aria-current="page">{t('detail.breadcrumb.works')}</li>
					</ol>
				</nav>

				<a href={homeUrl} class="halomot-btn halomot-btn--sm">
					<span class="halomot-inner">
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path
								d="M10 12L6 8L10 4"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						<span>{t('detail.breadcrumb.home')}</span>
					</span>
				</a>
			</div>

			<div class="works-hero">
				<div class="works-hero-top">
					<p class="works-eyebrow">
						{`${countLabel} ${lang === 'id' ? 'KARYA TERARSIP' : 'ARCHIVED WORKS'}`}
					</p>
				</div>
				<h1 class="works-title">{t('works.heading')}</h1>
				<p class="works-sub">{t('works.sub')}</p>
			</div>

			<div class="works-toolbar">
				<div class="filter-group" role="group" aria-label={t('works.filterAria')}>
					<button
						type="button"
						class="halomot-btn halomot-btn--sm is-active"
						data-filter-btn="all"
						aria-pressed="true"
					>
						<span class="halomot-inner">{t('works.filter.all')}</span>
					</button>
					<button
						type="button"
						class="halomot-btn halomot-btn--sm"
						data-filter-btn="iot"
						aria-pressed="false"
					>
						<span class="halomot-inner">{t('works.filter.iot')}</span>
					</button>
					<button
						type="button"
						class="halomot-btn halomot-btn--sm"
						data-filter-btn="ai"
						aria-pressed="false"
					>
						<span class="halomot-inner">{t('works.filter.ai')}</span>
					</button>
					<button
						type="button"
						class="halomot-btn halomot-btn--sm"
						data-filter-btn="software"
						aria-pressed="false"
					>
						<span class="halomot-inner">{t('works.filter.software')}</span>
					</button>
				</div>

				<div class="view-group" role="group" aria-label={t('works.viewAria')}>
					<button
						type="button"
						class="halomot-btn halomot-btn--sm is-active"
						data-view-btn="grid"
						aria-pressed="true"
					>
						<span class="halomot-inner">{t('works.view.grid')}</span>
					</button>
					<button
						type="button"
						class="halomot-btn halomot-btn--sm"
						data-view-btn="list"
						aria-pressed="false"
					>
						<span class="halomot-inner">{t('works.view.list')}</span>
					</button>
				</div>
			</div>

			<div class="works-container" data-works-container data-view-mode="grid">
				<div class="list-head" aria-hidden="true">
					<span>{t('works.col.title')}</span>
					<span>{t('works.col.cat')}</span>
					<span>{t('works.col.year')}</span>
				</div>

				{
					worksWithPreview.map(({ entry, previewSrc }, idx) => {
						const detailUrl = localePath(lang, `work/${entry.data.slugId}`);
						return (
							<article
								class="work-item framed-surface framed-surface--interactive"
								data-work-item
								data-category={entry.data.category}
								data-cover={previewSrc}
							>
								<a href={detailUrl} class="work-link framed-surface-inner">
									<div class="work-cover-thumb">
										<Image
											src={entry.data.cover}
											alt={entry.data.coverAlt}
											widths={[420, 720, 1000]}
											sizes="(max-width: 860px) 100vw, 420px"
											loading={idx < 3 ? 'eager' : 'lazy'}
											decoding="async"
											transition:name={`work-cover-${entry.data.slugId}`}
										/>
									</div>

									<div class="work-main">
										<div class="work-grid-meta">
											<span class="work-mono-meta">
												{`${categories[entry.data.category]} · ${entry.data.year}`}
											</span>
										</div>

										<div class="work-title-row">
											<h2 class="work-item-title">{entry.data.title}</h2>
										</div>

										<p class="work-item-summary">{entry.data.summary}</p>

										<div class="work-card-foot">
											<ul class="work-item-stack" aria-label={t('works.stackAria')}>
												{entry.data.stack.map((tech) => (
													<li>{tech}</li>
												))}
											</ul>
											<span class="work-read-cue" aria-hidden="true">
												{t('showcase.view')} →
											</span>
										</div>
									</div>

									<div class="work-cat">{categories[entry.data.category]}</div>
									<div class="work-year">{entry.data.year}</div>
								</a>
							</article>
						);
					})
				}
			</div>

			<div class="works-empty framed-surface" data-works-empty hidden>
				<div class="works-empty-inner framed-surface-inner">
					<p>{t('works.empty')}</p>
					<button type="button" class="halomot-btn halomot-btn--primary" data-works-reset>
						<span class="halomot-inner">{t('works.reset')}</span>
					</button>
				</div>
			</div>
		</div>

		<div class="cursor-preview framed-surface" data-cursor-preview aria-hidden="true">
			<div class="cursor-preview-inner framed-surface-inner">
				<img
					alt=""
					width="360"
					height="225"
					decoding="async"
					data-cursor-img
				/>
			</div>
		</div>
	</section>
</Layout>

<style>
	.works-page {
		padding-block: clamp(2.5rem, 6vw, 5rem);
		position: relative;
	}

	.works-hero {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.works-hero-top {
		margin-bottom: 0.65rem;
	}

	.works-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.works-title {
		font-size: clamp(2.25rem, 4.5vw, 3.75rem);
		margin-bottom: 0.65rem;
	}

	.works-sub {
		color: var(--muted);
		font-size: clamp(1rem, 0.96rem + 0.25vw, 1.125rem);
		max-width: 62ch;
	}

	.works-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--line);
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
		flex-wrap: wrap;
	}

	.filter-group,
	.view-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.list-head {
		display: grid;
		grid-template-columns: 1fr 160px 90px;
		gap: 1.25rem;
		padding: 0.85rem 1.25rem;
		border-bottom: 1px solid var(--line);
		background-color: var(--surface);
		border-radius: 12px 12px 0 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.works-container[data-view-mode='grid'] .list-head {
		display: none;
	}

	.works-container[data-view-mode='grid'] {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
		gap: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	.works-container[data-view-mode='grid'] .work-item {
		border-bottom: 0;
		display: flex;
	}

	.works-container[data-view-mode='grid'] .work-item:hover {
		transform: translateY(-2px);
	}

	.works-container[data-view-mode='grid'] .work-link {
		display: flex;
		flex-direction: column;
		width: 100%;
		padding: 0;
		gap: 0;
		background-color: var(--bg);
		align-items: stretch;
	}

	.works-container[data-view-mode='grid'] .work-cover-thumb {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		background-color: var(--surface);
		border-bottom: 1px solid var(--line);
		overflow: hidden;
	}

	.works-container[data-view-mode='grid'] .work-cover-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.35s ease;
	}

	.works-container[data-view-mode='grid'] .work-item:hover .work-cover-thumb img {
		transform: scale(1.025);
	}

	.works-container[data-view-mode='grid'] .work-main {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.35rem 1.4rem 1.4rem;
		gap: 0.65rem;
	}

	.work-grid-meta {
		display: none;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.works-container[data-view-mode='grid'] .work-grid-meta {
		display: flex;
	}

	.works-container[data-view-mode='grid'] .work-cat,
	.works-container[data-view-mode='grid'] .work-year {
		display: none;
	}

	.work-mono-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.work-card-foot {
		margin-top: auto;
		padding-top: 0.85rem;
		border-top: 1px solid var(--line);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.work-read-cue {
		display: none;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--fg);
	}

	.works-container[data-view-mode='grid'] .work-read-cue {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	/* List Mode */
	@media (min-width: 861px) {
		.works-container[data-view-mode='list'] {
			border: 1px solid var(--line);
			border-radius: 14px;
			overflow: hidden;
			background-color: var(--bg);
		}

		.works-container[data-view-mode='list'] .work-item {
			border-radius: 0;
			padding: 0;
			background: none;
			box-shadow: none;
			border-bottom: 1px solid var(--line);
		}

		.works-container[data-view-mode='list'] .work-item:last-child {
			border-bottom: 0;
		}

		.works-container[data-view-mode='list'] .work-link {
			display: grid;
			grid-template-columns: 1fr 160px 90px;
			gap: 1.25rem;
			padding: 1.4rem 1.25rem;
			border-radius: 0;
			background-color: transparent;
			align-items: baseline;
			transition: background-color 0.2s ease, color 0.2s ease;
		}

		.works-container[data-view-mode='list'] .work-link:hover {
			background-color: var(--surface);
		}
	}

	.works-container[data-view-mode='list'] .work-card-foot {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	.work-cover-thumb {
		display: none;
	}

	.work-title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.25rem;
	}

	.work-item-title {
		font-size: clamp(1.25rem, 1.8vw, 1.55rem);
		letter-spacing: -0.02em;
	}

	.work-item-summary {
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.55;
		max-width: 65ch;
	}

	.works-container[data-view-mode='list'] .work-item-summary {
		margin-bottom: 0.75rem;
	}

	.work-item-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.work-item-stack li {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--line);
		background-color: var(--surface);
		border-radius: 6px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
	}

	.work-cat,
	.work-year {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.works-empty {
		margin-top: 1.5rem;
	}

	.works-empty[hidden] {
		display: none;
	}

	.works-empty-inner {
		padding: 3rem 1.5rem;
		background-color: var(--bg);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.15rem;
	}

	.cursor-preview {
		position: fixed;
		top: 0;
		left: 0;
		width: 340px;
		pointer-events: none;
		z-index: 80;
		opacity: 0;
		transform: scale(0.94);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.cursor-preview-inner img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		display: block;
	}

	.cursor-preview.is-visible {
		opacity: 1;
		transform: scale(1);
	}

	@media (max-width: 860px) {
		.list-head,
		.view-group,
		.cursor-preview {
			display: none;
		}

		.works-container[data-view-mode='list'] {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.works-container[data-view-mode='list'] .work-item {
			border-bottom: 0;
		}

		.works-container[data-view-mode='list'] .work-link {
			display: flex;
			flex-direction: column;
			padding: 0;
			gap: 0;
			background-color: var(--bg);
		}

		.works-container[data-view-mode='list'] .work-cover-thumb {
			display: block;
			width: 100%;
			aspect-ratio: 16 / 10;
			background-color: var(--surface);
			border-bottom: 1px solid var(--line);
			overflow: hidden;
		}

		.works-container[data-view-mode='list'] .work-cover-thumb img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.works-container[data-view-mode='list'] .work-main {
			padding: 1.25rem;
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
		}

		.works-container[data-view-mode='list'] .work-grid-meta,
		.works-container[data-view-mode='list'] .work-read-cue {
			display: flex;
		}

		.works-container[data-view-mode='list'] .work-cat,
		.works-container[data-view-mode='list'] .work-year {
			display: none;
		}
	}
</style>
