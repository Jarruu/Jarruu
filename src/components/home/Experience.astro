---
import { Image } from 'astro:assets';
import { experiences } from '../../data/profile';
import { type Lang, useTranslations } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="exp-section">
	<div class="container">
		<h2 class="exp-heading">{t('exp.heading')}</h2>

		<div class="timeline-wrap" data-timeline-wrap>
			<div class="timeline-rail" aria-hidden="true">
				<div class="timeline-fill" data-timeline-progress></div>
			</div>

			<div class="timeline-list">
				{
					experiences.map((item) => {
						const isGrouped = item.roles.length > 1;

						return (
							<article class="timeline-item">
								<div class="timeline-meta">
									<span class="item-period">
										{item.period[lang]}
									</span>
									{item.photo && (
										<div class="timeline-photo-frame">
											<Image
												src={item.photo.src}
												alt={item.photo.alt[lang]}
												width={520}
												height={390}
												class="timeline-photo"
												loading="lazy"
											/>
										</div>
									)}
								</div>

								<div class="timeline-content">
									<div class="org-header">
										<h3 class="item-org-title">{item.org}</h3>
										<p class="item-org-loc">{item.location}</p>
									</div>

									<div class:list={['role-list', { 'is-grouped': isGrouped }]}>
										{item.roles.map((entry) => (
											<div class="role-entry">
												{isGrouped && (
													<span class="subrole-period">
														{entry.period[lang]}
													</span>
												)}
												<h4 class="item-role">{entry.role[lang]}</h4>
												<p class="item-summary">{entry.summary[lang]}</p>
												<ul class="item-highlights">
													{entry.highlights[lang].map((point) => (
														<li>{point}</li>
													))}
												</ul>
											</div>
										))}
									</div>
								</div>
							</article>
						);
					})
				}
			</div>
		</div>
	</div>
</section>

<style>
	.exp-section {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
		border-bottom: 1px solid var(--line);
	}

	.exp-heading {
		font-size: clamp(1.85rem, 3.4vw, 2.85rem);
	}

	.timeline-wrap {
		position: relative;
		padding-left: clamp(1.5rem, 3vw, 2.75rem);
		margin-top: clamp(2rem, 4vw, 3.5rem);
	}

	.timeline-rail {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background-color: var(--line);
	}

	.timeline-fill {
		width: 100%;
		height: 100%;
		background-color: var(--fg);
		transform-origin: top center;
	}

	.timeline-list {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: 1.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--line);
		align-items: start;
	}

	.timeline-item:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}

	.timeline-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.item-period {
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}

	.timeline-photo-frame {
		width: 100%;
		aspect-ratio: 4 / 3;
		border-radius: 8px;
		overflow: hidden;
		background-color: var(--surface);
		margin-top: 0.35rem;
	}

	.timeline-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transform: scale(1.03);
	}

	.item-org-title {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		margin-bottom: 0.25rem;
	}

	.item-org-loc {
		color: var(--muted);
		margin-bottom: 1rem;
	}

	.role-list.is-grouped {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.role-list.is-grouped .role-entry + .role-entry {
		padding-top: 1.5rem;
		border-top: 1px dashed var(--line);
	}

	.subrole-period {
		display: inline-block;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
		margin-bottom: 0.25rem;
	}

	.item-role {
		font-size: clamp(1.1rem, 1.7vw, 1.25rem);
		margin-bottom: 0.5rem;
	}

	.item-summary {
		margin-bottom: 0.75rem;
	}

	.item-highlights {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--muted);
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	@media (max-width: 860px) {
		.timeline-item {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.timeline-photo-frame {
			max-width: 360px;
		}
	}
</style>
