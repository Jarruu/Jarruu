---
import { profile } from '../data/profile';
import { type Lang, useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const socialLinks = [
	{ label: profile.socials.linkedin.label, url: profile.socials.linkedin.url },
	{ label: profile.socials.instagram.label, url: profile.socials.instagram.url },
	{ label: profile.socials.github.label, url: profile.socials.github.url },
];
---

<footer id="contact" class="site-footer">
	<div class="container footer-shell">
		<div class="footer-top">
			<div class="footer-cta">
				<h2 class="footer-heading">
					<span>{t('contact.line1')}</span>
					<span>{t('contact.line2')}</span>
				</h2>

				<div class="footer-pills">
					<a
						href={profile.socials.whatsapp.url}
						target="_blank"
						rel="noopener noreferrer"
						class="footer-pill"
					>
						<span>{t('contact.wa')}</span>
						<span aria-hidden="true">&rarr;</span>
					</a>
					<a href={profile.socials.email.url} class="footer-pill">
						<span>{t('contact.email')}</span>
						<span aria-hidden="true">@</span>
					</a>
				</div>
			</div>

			<nav class="footer-socials" aria-label={t('footer.socialsAria')}>
				{
					socialLinks.map((item) => (
						<a
							href={item.url}
							target="_blank"
							rel="noopener noreferrer"
							class="footer-social-link"
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</div>

		<div class="footer-wordmark-wrap" aria-hidden="true">
			<p class="footer-wordmark">FAJAR</p>
		</div>

		<div class="footer-bottom">
			<p>&copy;{year} &mdash; {profile.fullName}</p>
			<p>{t('footer.location')}</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background-color: #000000;
		color: #f4f4f2;
		padding-top: clamp(4.5rem, 9vw, 8rem);
		padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
	}

	.site-footer :global(:focus-visible) {
		outline: 2px solid #ffffff;
		outline-offset: 3px;
	}

	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 3rem;
		flex-wrap: wrap;
	}

	.footer-heading {
		display: flex;
		flex-direction: column;
		font-family: var(--font-sans);
		font-size: clamp(2.5rem, 5.2vw, 4.5rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: -0.03em;
		color: #ffffff;
		margin-bottom: 1.75rem;
	}

	.footer-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.footer-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 44px;
		padding: 0.65rem 1.35rem;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #ffffff;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.footer-pill:hover {
		background-color: #ffffff;
		color: #000000;
		border-color: #ffffff;
	}

	.footer-socials {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-right: clamp(0rem, 6vw, 6rem);
	}

	.footer-social-link {
		font-family: var(--font-sans);
		font-size: clamp(1.2rem, 1.8vw, 1.55rem);
		font-weight: 400;
		line-height: 1.35;
		color: #ffffff;
		transition: opacity 0.18s ease;
	}

	.footer-social-link:hover {
		opacity: 0.65;
	}

	.footer-wordmark-wrap {
		margin-top: clamp(3.5rem, 7vw, 6rem);
		margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
		overflow: hidden;
	}

	.footer-wordmark {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(4.25rem, 23.5vw, 21rem);
		line-height: 0.86;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		text-align: center;
		color: #ffffff;
		user-select: none;
		white-space: nowrap;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		font-size: 0.8125rem;
		color: rgba(244, 244, 242, 0.75);
	}

	@media (max-width: 720px) {
		.footer-top {
			flex-direction: column;
			align-items: flex-start;
		}

		.footer-socials {
			padding-right: 0;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
