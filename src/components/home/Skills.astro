---
import { skillGroups } from '../../data/profile';
import { type Lang, useTranslations } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="specs" class="skills-section">
	<div class="container">
		<div class="section-header">
			<span class="section-index">{t('skills.index')}</span>
			<span class="mono-meta">COMPONENT &amp; TOOLING MATRIX</span>
		</div>

		<h2 class="skills-heading" data-reveal>{t('skills.heading')}</h2>

		<div class="spec-sheet" role="region" aria-label={t('skills.heading')} data-reveal>
			<div class="spec-head mono-meta">
				<div>CODE</div>
				<div>{t('skills.col.domain')}</div>
				<div>{t('skills.col.items')}</div>
				<div>{t('skills.col.context')}</div>
			</div>

			{
				skillGroups.map((group) => (
					<div class="spec-row">
						<div class="mono-meta spec-code">{group.code}</div>
						<div class="spec-domain">{group.domain[lang]}</div>
						<ul class="spec-tags" aria-label={group.domain[lang]}>
							{group.items.map((item) => (
								<li class="mono-meta">{item}</li>
							))}
						</ul>
						<div class="spec-context">{group.context[lang]}</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.skills-section {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
		border-bottom: 1px solid var(--line);
	}

	.skills-heading {
		font-size: clamp(1.85rem, 3.4vw, 2.85rem);
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.spec-sheet {
		border: 1.5px solid var(--border-strong);
	}

	.spec-head,
	.spec-row {
		display: grid;
		grid-template-columns: 90px 1.1fr 1.8fr 1.3fr;
		gap: 1.25rem;
		padding: 1.25rem 1.5rem;
		align-items: center;
	}

	.spec-head {
		background-color: var(--surface);
		border-bottom: 1.5px solid var(--border-strong);
		font-weight: 600;
	}

	.spec-row {
		border-bottom: 1px solid var(--line);
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.spec-row:last-child {
		border-bottom: 0;
	}

	.spec-row:hover {
		background-color: var(--inv-bg);
		color: var(--inv-fg);
	}

	.spec-row:hover .mono-meta,
	.spec-row:hover .spec-context {
		color: var(--inv-fg);
	}

	.spec-domain {
		font-family: 'Bricolage Grotesque Variable', sans-serif;
		font-size: 1.125rem;
		font-weight: 600;
	}

	.spec-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.spec-tags li {
		padding: 0.1875rem 0.5rem;
		border: 1px solid var(--border-strong);
	}

	.spec-context {
		font-size: 0.9375rem;
		color: var(--muted);
	}

	@media (max-width: 960px) {
		.spec-head {
			display: none;
		}

		.spec-row {
			grid-template-columns: 1fr;
			gap: 0.625rem;
		}
	}
</style>
