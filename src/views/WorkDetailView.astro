---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { type Lang, useTranslations, localePath } from '../i18n/utils';

interface Props {
	lang: Lang;
	entry: CollectionEntry<'works'>;
	nextEntry: CollectionEntry<'works'>;
}

const { lang, entry, nextEntry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const archiveUrl = localePath(lang, 'work');
const nextUrl = localePath(lang, `work/${nextEntry.data.slugId}`);
---

<Layout lang={lang} title={entry.data.title} description={entry.data.summary}>
	<article class="detail-page">
		<div class="container">
			<div class="detail-topbar">
				<a href={archiveUrl} class="btn-secondary">
					{t('detail.back')}
				</a>
				<span class="mono-meta">
					SPEC // {entry.data.category.toUpperCase()} · {entry.data.year}
				</span>
			</div>

			{
				entry.data.placeholder && (
					<div class="placeholder-banner" role="note">
						<span class="mono-meta">{t('detail.placeholder.notice')}</span>
					</div>
				)
			}

			<header class="detail-header">
				<h1 class="detail-title">{entry.data.title}</h1>
				<p class="detail-summary">{entry.data.summary}</p>
			</header>

			<div class="detail-cover">
				<img
					src={entry.data.cover}
					alt={entry.data.coverAlt}
					width="1000"
					height="625"
					fetchpriority="high"
					transition:name={`work-cover-${entry.data.slugId}`}
				/>
			</div>

			<div class="detail-grid">
				<aside class="detail-sidebar" aria-label="Technical specifications">
					<dl class="meta-list">
						<div class="meta-item">
							<dt class="mono-meta">{t('detail.role')}</dt>
							<dd>{entry.data.role}</dd>
						</div>
						<div class="meta-item">
							<dt class="mono-meta">{t('detail.category')}</dt>
							<dd>{entry.data.category.toUpperCase()}</dd>
						</div>
						<div class="meta-item">
							<dt class="mono-meta">{t('detail.year')}</dt>
							<dd>{entry.data.year}</dd>
						</div>
						{
							entry.data.specs.map((s) => (
								<div class="meta-item">
									<dt class="mono-meta">{s.label}</dt>
									<dd>{s.value}</dd>
								</div>
							))
						}
						<div class="meta-item">
							<dt class="mono-meta">{t('detail.stack')}</dt>
							<dd>
								<ul class="stack-pills">
									{entry.data.stack.map((tech) => (
										<li class="mono-meta">{tech}</li>
									))}
								</ul>
							</dd>
						</div>
					</dl>
				</aside>

				<div class="detail-prose">
					<Content />
				</div>
			</div>

			<footer class="next-project">
				<p class="mono-meta">{t('detail.next')}</p>
				<a href={nextUrl} class="next-link">
					<span class="next-title">{nextEntry.data.title}</span>
					<span class="mono-meta">
						{nextEntry.data.category.toUpperCase()} · {nextEntry.data.year}
					</span>
				</a>
			</footer>
		</div>
	</article>
</Layout>

<style>
	.detail-page {
		padding-block: clamp(2rem, 5vw, 4.5rem);
	}

	.detail-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--line);
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.placeholder-banner {
		padding: 0.875rem 1.25rem;
		border: 1.5px solid var(--border-strong);
		background-color: var(--surface);
		margin-bottom: 2rem;
	}

	.detail-header {
		max-width: 820px;
		margin-bottom: 2rem;
	}

	.detail-title {
		font-size: clamp(2rem, 4.2vw, 3.5rem);
		margin-bottom: 0.75rem;
	}

	.detail-summary {
		font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
		color: var(--muted);
	}

	.detail-cover {
		border: 1.5px solid var(--border-strong);
		background-color: var(--surface);
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.detail-cover img {
		width: 100%;
		height: auto;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
		padding-bottom: clamp(3rem, 6vw, 5rem);
		border-bottom: 1.5px solid var(--fg);
	}

	.detail-sidebar {
		border: 1px solid var(--border-strong);
		background-color: var(--surface);
		padding: 1.5rem;
	}

	.meta-list {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.meta-item {
		padding-bottom: 0.875rem;
		border-bottom: 1px solid var(--line);
	}

	.meta-item:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.meta-item dd {
		margin: 0.25rem 0 0;
		font-weight: 500;
	}

	.stack-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		padding: 0;
		margin: 0.375rem 0 0;
	}

	.stack-pills li {
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--border-strong);
	}

	.detail-prose :global(h2) {
		font-size: 1.65rem;
		margin: 2rem 0 0.75rem;
	}

	.detail-prose :global(h2:first-child) {
		margin-top: 0;
	}

	.detail-prose :global(p),
	.detail-prose :global(ul),
	.detail-prose :global(ol) {
		margin: 0 0 1.25rem;
		color: var(--fg);
	}

	.detail-prose :global(li) {
		margin-bottom: 0.5rem;
	}

	.detail-prose :global(pre) {
		padding: 1.25rem;
		border: 1px solid var(--border-strong);
		background-color: var(--surface) !important;
		overflow-x: auto;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.875rem;
	}

	.next-project {
		padding-top: 2.5rem;
	}

	.next-link {
		margin-top: 0.75rem;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.5rem;
		border: 1.5px solid var(--border-strong);
		transition: background-color 0.15s ease, color 0.15s ease;
		flex-wrap: wrap;
	}

	.next-link:hover {
		background-color: var(--inv-bg);
		color: var(--inv-fg);
	}

	.next-link:hover .mono-meta {
		color: var(--inv-fg);
	}

	.next-title {
		font-family: 'Bricolage Grotesque Variable', sans-serif;
		font-size: clamp(1.35rem, 2.5vw, 2rem);
		font-weight: 600;
	}

	@media (max-width: 900px) {
		.detail-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
