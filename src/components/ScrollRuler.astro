---
const ticks = Array.from({ length: 51 }, (_, idx) => {
	const value = idx * 2;
	return {
		value,
		isMajor: value % 10 === 0,
	};
});
---

<aside class="scroll-ruler" data-scroll-ruler aria-hidden="true">
	<div class="ruler-needle" data-ruler-needle>
		<span class="ruler-readout" data-ruler-readout>00</span>
		<span class="ruler-needle-line"></span>
	</div>

	<div class="ruler-window" data-ruler-window>
		<div class="ruler-tape" data-ruler-tape>
			{
				ticks.map((tick) => (
					<div
						class:list={['ruler-tick', tick.isMajor ? 'is-major' : 'is-minor']}
						data-ruler-tick
						data-ruler-value={tick.value}
					>
						{tick.isMajor && <span class="ruler-label">{tick.value}</span>}
						<span class="ruler-mark" />
					</div>
				))
			}
		</div>
	</div>
</aside>

<script>
	import { onPageLoad, prefersReducedMotion, scrollToRatio } from '../scripts/lib/lifecycle';

	onPageLoad(() => {
		const root = document.querySelector<HTMLElement>('[data-scroll-ruler]');
		const windowEl = root?.querySelector<HTMLElement>('[data-ruler-window]');
		const tape = root?.querySelector<HTMLElement>('[data-ruler-tape]');
		const readout = root?.querySelector<HTMLElement>('[data-ruler-readout]');
		if (!root || !windowEl || !tape || !readout) return;

		const ticks = Array.from(tape.querySelectorAll<HTMLElement>('[data-ruler-tick]'));
		if (ticks.length < 2) return;

		let rafId = 0;
		let isDragging = false;
		let hasDragged = false;
		let startY = 0;
		let startRatio = 0;
		let activePointerId: number | null = null;

		const getMetrics = () => {
			const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
			const ratio = maxScroll > 0 ? Math.max(0, Math.min(1, window.scrollY / maxScroll)) : 0;
			const step = ticks[0].offsetHeight || 10;
			const span = (ticks.length - 1) * step;
			const winHeight = windowEl.clientHeight || 360;
			return { maxScroll, ratio, step, span, winHeight };
		};

		const render = () => {
			rafId = 0;
			const { maxScroll, ratio, step, span, winHeight } = getMetrics();
			root.classList.toggle('is-hidden', maxScroll <= 4);

			const halfWin = winHeight / 2;
			const offset = halfWin - (step / 2 + ratio * span);
			tape.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;

			const pct = Math.round(ratio * 100);
			readout.textContent = String(pct).padStart(2, '0');

			for (let i = 0; i < ticks.length; i++) {
				const tickCenter = offset + i * step + step / 2;
				const dist = Math.abs(tickCenter - halfWin) / halfWin;
				const alpha = Math.max(0.1, 1 - dist * 0.88);
				ticks[i].style.opacity = alpha.toFixed(2);
			}
		};

		const scheduleRender = () => {
			if (!rafId) {
				rafId = window.requestAnimationFrame(render);
			}
		};

		const onPointerDown = (e: PointerEvent) => {
			if (e.button !== 0) return;
			const { maxScroll, ratio } = getMetrics();
			if (maxScroll <= 4) return;

			isDragging = true;
			hasDragged = false;
			startY = e.clientY;
			startRatio = ratio;
			activePointerId = e.pointerId;
			root.classList.add('is-dragging');
			windowEl.setPointerCapture(e.pointerId);
			e.preventDefault();
		};

		const onPointerMove = (e: PointerEvent) => {
			if (!isDragging || e.pointerId !== activePointerId) return;
			const dy = e.clientY - startY;
			if (!hasDragged && Math.abs(dy) >= 4) {
				hasDragged = true;
			}
			if (!hasDragged) return;

			const { span } = getMetrics();
			if (span <= 0) return;
			const nextRatio = Math.max(0, Math.min(1, startRatio - dy / span));
			scrollToRatio(nextRatio, true);
		};

		const onPointerUp = (e: PointerEvent) => {
			if (!isDragging || e.pointerId !== activePointerId) return;
			isDragging = false;
			root.classList.remove('is-dragging');
			if (windowEl.hasPointerCapture(e.pointerId)) {
				windowEl.releasePointerCapture(e.pointerId);
			}

			if (!hasDragged) {
				const target = document.elementFromPoint(e.clientX, e.clientY);
				const tickEl = target?.closest<HTMLElement>('[data-ruler-value]');
				if (tickEl) {
					const val = Number(tickEl.dataset.rulerValue);
					if (Number.isFinite(val)) {
						scrollToRatio(val / 100, prefersReducedMotion());
					}
				}
			}
			activePointerId = null;
		};

		window.addEventListener('scroll', scheduleRender, { passive: true });
		window.addEventListener('resize', scheduleRender, { passive: true });
		windowEl.addEventListener('pointerdown', onPointerDown);
		windowEl.addEventListener('pointermove', onPointerMove);
		windowEl.addEventListener('pointerup', onPointerUp);
		windowEl.addEventListener('pointercancel', onPointerUp);

		const resizeObserver = new ResizeObserver(scheduleRender);
		resizeObserver.observe(document.documentElement);

		render();

		return () => {
			if (rafId) window.cancelAnimationFrame(rafId);
			window.removeEventListener('scroll', scheduleRender);
			window.removeEventListener('resize', scheduleRender);
			windowEl.removeEventListener('pointerdown', onPointerDown);
			windowEl.removeEventListener('pointermove', onPointerMove);
			windowEl.removeEventListener('pointerup', onPointerUp);
			windowEl.removeEventListener('pointercancel', onPointerUp);
			resizeObserver.disconnect();
		};
	});
</script>

<style>
	.scroll-ruler {
		position: fixed;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		z-index: 45;
		width: 92px;
		height: min(52vh, 360px);
		color: #ffffff;
		mix-blend-mode: difference;
		user-select: none;
	}

	.scroll-ruler.is-hidden {
		display: none;
	}

	.ruler-window {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		cursor: grab;
		touch-action: none;
	}

	.scroll-ruler.is-dragging .ruler-window {
		cursor: grabbing;
	}

	.ruler-tape {
		position: relative;
		width: 100%;
		will-change: transform;
	}

	.ruler-tick {
		height: 10px;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 6px;
		padding-right: 0;
	}

	.ruler-label {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
		color: #ffffff;
	}

	.ruler-mark {
		display: block;
		background-color: #ffffff;
		flex-shrink: 0;
	}

	.ruler-tick.is-minor .ruler-mark {
		width: 8px;
		height: 1px;
	}

	.ruler-tick.is-major .ruler-mark {
		width: 15px;
		height: 1.5px;
	}

	.ruler-needle {
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 28px;
		pointer-events: none;
	}

	.ruler-needle-line {
		display: block;
		width: 22px;
		height: 2px;
		background-color: #ffffff;
	}

	.ruler-readout {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		padding: 0.16rem 0.3rem;
		border: 1px solid #ffffff;
		border-radius: 3px;
		color: #ffffff;
	}

	@media (max-width: 768px) {
		.scroll-ruler {
			display: none;
		}
	}
</style>
