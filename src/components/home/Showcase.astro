---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { type Lang, useTranslations, localePath } from '../../i18n/utils';

interface Props {
	lang: Lang;
	works: CollectionEntry<'works'>[];
}

const { lang, works } = Astro.props;
const t = useTranslations(lang);
const allWorksUrl = localePath(lang, 'work');
const categoryLabel = (category: 'iot' | 'ai' | 'software') => t(`works.filter.${category}`);

const items = works.map((entry) => ({
	slugId: entry.data.slugId,
	title: entry.data.title,
	meta: `${categoryLabel(entry.data.category)} · ${entry.data.year}`,
	summary: entry.data.summary,
	cover: entry.data.cover,
	coverAlt: entry.data.coverAlt,
	url: localePath(lang, `work/${entry.data.slugId}`),
}));

const clientItems = items.map(({ title, meta, summary, url }) => ({ title, meta, summary, url }));

const firstItem = items[0];
const totalItems = items.length;
const deckTilts = [-7, 6, -5, 8];
---

<section id="work-showcase" class="showcase-section" data-showcase-section>
	<span id="selected-works" class="sr-only"></span>
	<div class="container">
		<div class="showcase-intro">
			<div>
				<h2 class="showcase-heading">{t('showcase.heading')}</h2>
				<p class="showcase-sub">{t('showcase.sub')}</p>
			</div>
			<div class="showcase-actions">
				<a href={allWorksUrl} class="halomot-btn halomot-btn--sm">
					<span class="halomot-inner">{t('showcase.all')}</span>
				</a>
			</div>
		</div>

		{
			firstItem && (
				<div class="showcase-split">
					<div class="showcase-deck-col">
						<div class="showcase-deck" data-showcase-deck>
							{items.map((item, idx) => {
								const isActive = idx === 0;
								const tilt = deckTilts[idx % deckTilts.length];
								const initialStyle = isActive
									? `z-index: ${totalItems + 1}; transform: scale(1) rotate(0deg); opacity: 1;`
									: `z-index: ${totalItems - idx}; transform: scale(0.95) rotate(${tilt}deg); opacity: 0.72;`;
								return (
									<a
										href={item.url}
										class:list={['deck-card framed-surface framed-surface--interactive', isActive && 'is-active']}
										data-deck-card
										data-index={idx}
										data-tilt={tilt}
										aria-current={isActive ? 'true' : 'false'}
										style={initialStyle}
									>
										<span class="deck-card-inner framed-surface-inner">
											<Image
												src={item.cover}
												alt={item.coverAlt}
												widths={[480, 760, 1000]}
												sizes="(max-width: 1023px) 100vw, 52vw"
												loading={idx === 0 ? 'eager' : 'lazy'}
												decoding="async"
												transition:name={`work-cover-${item.slugId}`}
											/>
										</span>
									</a>
								);
							})}
						</div>
					</div>

					<div class="showcase-info-col">
						<div class="showcase-details" aria-live="polite">
							<div class="showcase-meta-row">
								<p class="showcase-meta" data-showcase-meta>
									{firstItem.meta}
								</p>
								<span class="showcase-counter" data-showcase-counter>
									{`01 / ${String(totalItems).padStart(2, '0')}`}
								</span>
							</div>

							<h3 class="showcase-title" data-showcase-title>
								{firstItem.title}
							</h3>

							<p class="showcase-quote" data-showcase-quote>
								{firstItem.summary.split(' ').map((word, idx) => (
									<Fragment>
										{idx > 0 && ' '}
										<span class="quote-word">{word}</span>
									</Fragment>
								))}
							</p>
						</div>

						<div class="showcase-controls">
							<div class="showcase-nav-group">
								<button type="button" class="halomot-btn" data-showcase-prev>
									<span class="halomot-inner">{t('showcase.prev')}</span>
								</button>
								<button type="button" class="halomot-btn" data-showcase-next>
									<span class="halomot-inner">{t('showcase.next')}</span>
								</button>
							</div>
							<a href={firstItem.url} class="halomot-btn halomot-btn--primary" data-showcase-open>
								<span class="halomot-inner">{t('showcase.view')}</span>
							</a>
						</div>
					</div>
				</div>
			)
		}
	</div>

	<script
		type="application/json"
		data-showcase-items
		set:html={JSON.stringify(clientItems).replace(/</g, '\\u003c')}
	/>
</section>

<script>
	import { gsap, prefersReducedMotion } from '../../scripts/lib/lifecycle';

	interface ShowcaseItem {
		title: string;
		meta: string;
		summary: string;
		url: string;
	}

	let cleanupShowcase: (() => void) | null = null;

	function initShowcase() {
		cleanupShowcase?.();
		cleanupShowcase = null;

		const section = document.querySelector<HTMLElement>('[data-showcase-section]');
		const rawData = section?.querySelector<HTMLScriptElement>('[data-showcase-items]')?.textContent;
		if (!section || !rawData) return;

		let items: ShowcaseItem[] = [];
		try {
			items = JSON.parse(rawData);
		} catch {
			return;
		}
		if (items.length === 0) return;

		const cards = Array.from(section.querySelectorAll<HTMLAnchorElement>('[data-deck-card]'));
		const titleEl = section.querySelector<HTMLElement>('[data-showcase-title]');
		const metaEl = section.querySelector<HTMLElement>('[data-showcase-meta]');
		const counterEl = section.querySelector<HTMLElement>('[data-showcase-counter]');
		const quoteEl = section.querySelector<HTMLElement>('[data-showcase-quote]');
		const openEl = section.querySelector<HTMLAnchorElement>('[data-showcase-open]');
		const prevBtn = section.querySelector<HTMLButtonElement>('[data-showcase-prev]');
		const nextBtn = section.querySelector<HTMLButtonElement>('[data-showcase-next]');
		const controlsEl = section.querySelector<HTMLElement>('.showcase-controls');
		const deckEl = section.querySelector<HTMLElement>('[data-showcase-deck]');

		const total = items.length;
		let active = 0;
		const controller = new AbortController();
		const { signal } = controller;

		const formatCounter = (idx: number) =>
			`${String(idx + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;

		const renderQuoteWords = (text: string, animate: boolean) => {
			if (!quoteEl) return;
			gsap.killTweensOf(quoteEl.querySelectorAll('.quote-word'));
			quoteEl.textContent = '';

			const words = text.trim().split(/\s+/);
			const spans: HTMLSpanElement[] = [];

			words.forEach((word, i) => {
				if (i > 0) quoteEl.appendChild(document.createTextNode(' '));
				const span = document.createElement('span');
				span.className = 'quote-word';
				span.textContent = word;
				quoteEl.appendChild(span);
				spans.push(span);
			});

			if (animate) {
				gsap.fromTo(
					spans,
					{ opacity: 0, y: 6, filter: 'blur(8px)' },
					{
						opacity: 1,
						y: 0,
						filter: 'blur(0px)',
						duration: 0.28,
						stagger: 0.02,
						ease: 'power2.out',
						clearProps: 'filter,transform',
					}
				);
			}
		};

		const applyDeckLayout = (nextIdx: number, animate: boolean) => {
			cards.forEach((card, idx) => {
				const isActive = idx === nextIdx;
				const baseTilt = Number(card.dataset.tilt || '0');
				const distance = (idx - nextIdx + total) % total;
				const zIndex = isActive ? total + 2 : total - distance;

				card.classList.toggle('is-active', isActive);
				card.setAttribute('aria-current', isActive ? 'true' : 'false');
				gsap.killTweensOf(card);
				card.style.zIndex = String(zIndex);

				if (!animate) {
					gsap.set(card, {
						scale: isActive ? 1 : 0.95,
						rotation: isActive ? 0 : baseTilt,
						opacity: isActive ? 1 : 0.72,
						y: 0,
					});
					return;
				}

				if (isActive) {
					gsap.fromTo(
						card,
						{ scale: 0.95, rotation: baseTilt, opacity: 0.85, y: 0 },
						{
							keyframes: [
								{ y: -48, scale: 0.99, rotation: 0, opacity: 1, duration: 0.2, ease: 'power2.out' },
								{ y: 0, scale: 1, rotation: 0, opacity: 1, duration: 0.24, ease: 'power3.out' },
							],
						}
					);
				} else {
					gsap.to(card, {
						scale: 0.95,
						rotation: baseTilt,
						opacity: 0.72,
						y: 0,
						duration: 0.36,
						ease: 'power2.out',
					});
				}
			});
		};

		const setActive = (nextIdx: number) => {
			const normalized = (nextIdx + total) % total;
			if (normalized === active) return;
			active = normalized;

			const item = items[active];
			const animate = !prefersReducedMotion();

			if (titleEl) {
				titleEl.textContent = item.title;
				if (animate) {
					gsap.fromTo(
						titleEl,
						{ opacity: 0, y: 12 },
						{ opacity: 1, y: 0, duration: 0.28, ease: 'power2.out', clearProps: 'transform' }
					);
				}
			}

			if (metaEl) metaEl.textContent = item.meta;
			if (counterEl) counterEl.textContent = formatCounter(active);
			if (openEl) openEl.href = item.url;

			renderQuoteWords(item.summary, animate);
			applyDeckLayout(active, animate);
		};

		prevBtn?.addEventListener('click', () => setActive(active - 1), { signal });
		nextBtn?.addEventListener('click', () => setActive(active + 1), { signal });

		cards.forEach((card) => {
			card.addEventListener(
				'click',
				(event) => {
					const idx = Number(card.dataset.index || '0');
					if (idx !== active) {
						event.preventDefault();
						setActive(idx);
					}
				},
				{ signal }
			);
		});

		const onKeyDown = (event: KeyboardEvent) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				setActive(active - 1);
			} else if (event.key === 'ArrowRight') {
				event.preventDefault();
				setActive(active + 1);
			}
		};

		controlsEl?.addEventListener('keydown', onKeyDown, { signal });
		deckEl?.addEventListener('keydown', onKeyDown, { signal });

		cleanupShowcase = () => {
			controller.abort();
			gsap.killTweensOf(cards);
			if (titleEl) gsap.killTweensOf(titleEl);
			if (quoteEl) gsap.killTweensOf(quoteEl.querySelectorAll('.quote-word'));
		};
	}

	document.addEventListener('astro:page-load', initShowcase);
	document.addEventListener('astro:before-swap', () => {
		cleanupShowcase?.();
		cleanupShowcase = null;
	});
</script>

<style>
	.showcase-section {
		padding-block: clamp(4.5rem, 8vw, 7.5rem);
		border-bottom: 1px solid var(--line);
		overflow-x: clip;
	}

	.showcase-intro {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1.5rem 2rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.showcase-heading {
		margin-bottom: 0.75rem;
	}

	.showcase-sub {
		max-width: 36rem;
		font-size: clamp(1rem, 0.96rem + 0.25vw, 1.125rem);
		color: var(--muted);
	}

	.showcase-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.showcase-split {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(2.25rem, 5vw, 4.5rem);
		align-items: stretch;
	}

	@media (min-width: 1024px) {
		.showcase-split {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		}
	}

	.showcase-deck-col {
		display: flex;
		align-items: center;
		width: 100%;
		padding-block: 0.75rem;
	}

	.showcase-deck {
		position: relative;
		width: 100%;
		aspect-ratio: 1.37 / 1;
	}

	.deck-card {
		position: absolute;
		inset: 0;
		display: block;
		transform-origin: center bottom;
		will-change: transform, opacity;
		text-decoration: none;
	}

	.deck-card:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 4px;
	}

	.deck-card-inner {
		display: block;
		width: 100%;
		height: 100%;
	}

	.deck-card-inner img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		pointer-events: none;
	}

	.showcase-info-col {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2.25rem;
		padding-block: 0.25rem;
	}

	.showcase-details {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.showcase-meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 1rem;
	}

	.showcase-meta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.showcase-counter {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--muted);
		padding-left: 0.85rem;
		border-left: 1px solid var(--line);
	}

	.showcase-title {
		font-size: clamp(1.5rem, 1.25rem + 1.2vw, 2.25rem);
		line-height: 1.12;
		letter-spacing: -0.025em;
		color: var(--fg);
	}

	.showcase-quote {
		font-size: clamp(1rem, 0.94rem + 0.3vw, 1.15rem);
		line-height: 1.6;
		color: var(--muted);
		max-width: 38rem;
	}

	.showcase-quote :global(.quote-word) {
		display: inline-block;
		will-change: transform, opacity, filter;
	}

	.showcase-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
	}

	.showcase-nav-group {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}

	@media (max-width: 640px) {
		.showcase-controls {
			flex-direction: column;
			align-items: stretch;
		}

		.showcase-nav-group {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}

		.showcase-controls :global(.halomot-btn),
		.showcase-controls :global(.halomot-inner) {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.deck-card {
			transition: none;
		}
	}
</style>
