---
import { Image } from 'astro:assets';
import mePhoto from '../../assets/foto-formal-nobg.png';
import { profile } from '../../data/profile';
import { type Lang, useTranslations } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const statementWords = t('about.statement').split(' ');

const disciplines = [
	{
		title: t('about.d1.title'),
		desc: t('about.d1.desc'),
		spec: t('about.d1.spec'),
	},
	{
		title: t('about.d2.title'),
		desc: t('about.d2.desc'),
		spec: t('about.d2.spec'),
	},
	{
		title: t('about.d3.title'),
		desc: t('about.d3.desc'),
		spec: t('about.d3.spec'),
	},
];
---

<section id="about" class="about-section">
	<div class="container">
		<div class="about-lead">
			<div class="about-photo-wrap">
				<Image
					src={mePhoto}
					alt={profile.fullName}
					width={368}
					height={368}
					class="about-photo"
					loading="lazy"
				/>
				<p class="about-affiliation">
					{t('about.institution')}<br />{t('about.dept')}
				</p>
			</div>

			<div class="about-lead-copy">
				<h2 class="about-heading">{t('about.heading')}</h2>
				<p class="about-statement" data-about-statement>
					{
						statementWords.map((word) => (
							<>
								<span class="scrub-word" data-scrub-word>{word}</span>{' '}
							</>
						))
					}
				</p>
			</div>
		</div>

		<div class="discipline-table">
			{
				disciplines.map((item) => (
					<article class="discipline-row">
						<h3 class="row-title">{item.title}</h3>
						<p class="row-desc">{item.desc}</p>
						<div class="row-spec">{item.spec}</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.about-section {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
		border-bottom: 1px solid var(--line);
	}

	.about-lead {
		display: grid;
		grid-template-columns: clamp(160px, 18vw, 220px) 1fr;
		gap: clamp(2rem, 4vw, 3.5rem);
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
		align-items: start;
	}

	.about-photo-wrap {
		width: 100%;
	}

	.about-photo {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: contain;
		display: block;
		-webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 98%);
		mask-image: linear-gradient(to bottom, black 72%, transparent 98%);
	}

	.about-affiliation {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--muted);
	}

	.about-lead-copy {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.about-heading {
		font-size: clamp(1.75rem, 2.8vw, 2.5rem);
		max-width: 26ch;
	}

	.about-statement {
		font-size: clamp(1.125rem, 1.5vw, 1.35rem);
		line-height: 1.55;
		max-width: 62ch;
	}

	.scrub-word {
		display: inline;
	}

	.discipline-table {
		border-top: 1.5px solid var(--fg);
	}

	.discipline-row {
		display: grid;
		grid-template-columns: 1.1fr 1.5fr 1fr;
		gap: 1.5rem;
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--line);
		align-items: baseline;
	}

	.row-title {
		font-size: 1.25rem;
	}

	.row-desc {
		color: var(--muted);
		font-size: 0.96875rem;
	}

	.row-spec {
		font-size: 0.8125rem;
		color: var(--muted);
		text-align: right;
	}

	@media (max-width: 960px) {
		.about-lead {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.about-photo-wrap {
			max-width: 170px;
		}

		.discipline-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.row-spec {
			text-align: left;
		}
	}
</style>
